{
  "name": "@@vibe/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "vibe": "./bin/vibe.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "scripts",
    "dist"
  ],
  "scripts": {
    "build": "vite build && node ../../tools/bundle-dts.mjs src/index.ts src/cli.ts",
    "dev": "vite build --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:types": "tsd",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "dts-bundle-generator": "9.5.1",
    "tsd": "^0.31.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "tsd": {
    "directory": "type-tests"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
